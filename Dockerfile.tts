# Qwen3-TTS Standalone — faster-qwen3-tts with CUDA graphs
# Uses andimarafioti/faster-qwen3-tts for ~5x lower TTFA via static KV cache.
#
# Usage:
#   docker build -f Dockerfile.tts -t faster-qwen3-tts .
#   docker run --gpus all -p 8880:8880 faster-qwen3-tts

ARG BASE_IMAGE="nvidia/cuda"
ARG BASE_IMAGE_TAG="12.4.1-devel-ubuntu22.04"
FROM ${BASE_IMAGE}:${BASE_IMAGE_TAG}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# NVIDIA runtime
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:${LD_LIBRARY_PATH}

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3-pip \
    ffmpeg \
    libsndfile1 \
    libsox-dev \
    sox \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/python3 /usr/bin/python

# ─── faster-qwen3-tts Setup ─────────────────────────────────────────────────
WORKDIR /app/tts

RUN python3 -m venv .venv

# PyTorch with CUDA 12.1
RUN .venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && .venv/bin/pip install --no-cache-dir \
    "torch>=2.5.1" \
    "torchaudio>=2.5.1" \
    --index-url https://download.pytorch.org/whl/cu121

# faster-qwen3-tts (pulls qwen-tts, transformers, etc.)
RUN .venv/bin/pip install --no-cache-dir \
    "faster-qwen3-tts>=0.2.4" \
    "aiohttp>=3.9.0" \
    "librosa" \
    "scipy"

# flash-attn for faster inference (requires devel image for nvcc)
ENV TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0"
RUN .venv/bin/pip install --no-cache-dir flash-attn --no-build-isolation || \
    echo "WARNING: flash-attn build failed, falling back to SDPA"

# Copy server
COPY qwen3-tts/tts_streaming_server.py ./

# Cache dirs
RUN mkdir -p /root/.cache /tmp/numba_cache

# ─── Runtime ──────────────────────────────────────────────────────────────────
EXPOSE 8880

ENV HOST=0.0.0.0
ENV PORT=8880
ENV TTS_MODEL_NAME=Qwen/Qwen3-TTS-12Hz-1.7B-Base
ENV TTS_CHUNK_SIZE=8
ENV PYTHONPATH=/app/tts

HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
    CMD curl -f http://localhost:8880/health || exit 1

CMD [".venv/bin/python", "tts_streaming_server.py"]
